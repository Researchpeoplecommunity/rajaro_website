# Local development only — copy to .env and adjust values.
FLASK_DEBUG=1
SECRET_KEY=local-dev-secret-change-me
DATABASE_URL=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# UPLOAD_FOLDER=static/uploads

# Form submission email alerts (optional locally — required for production notifications)
NOTIFY_EMAIL=contact@rajaro.com
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-smtp-user@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_USE_TLS=1
MAIL_FROM=your-smtp-user@gmail.com
